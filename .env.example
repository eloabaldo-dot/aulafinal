# ==============================================================================
# SmartTrip - Variáveis de Ambiente de Exemplo
# ==============================================================================
# ATENÇÃO: NUNCA insira chaves reais neste arquivo.
# Copie este arquivo para .env.local e preencha as variáveis correspondentes.
# ==============================================================================

# Google Gemini API
# Obtenha sua chave no Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Firebase Client SDK (Configurações públicas do projeto Firebase)
# Disponíveis no Console do Firebase > Configurações do Projeto
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (Opcional para backend/funções administrativas)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# URL Base da Aplicação (Ambiente Local ou Produção na Vercel)
APP_URL=http://localhost:3000
